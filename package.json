{
  "name": "gevyro-financas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "npm run check:costs && node scripts/generate-cost-report.mjs && next build --webpack",
    "start": "node scripts/serve.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:db": "bash scripts/test-db.sh",
    "check:costs": "node scripts/check-cost-policy.mjs",
    "test:db:shared": "bash scripts/test-shared-db.sh",
    "check:security": "node scripts/check-security.mjs",
    "test:db:isolated": "bash scripts/test-gevyro-db.sh",
    "test:responsive": "playwright test"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.8",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/supabase-js": "2.99.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "idb": "^8.0.4",
    "lucide-react": "^1.77.0",
    "next": "^16.4.6",
    "papaparse": "^5.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "recharts": "^3.11.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^26.1.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "8.3.8",
    "vitest": "^4.1.12"
  },
  "type": "module"
}
